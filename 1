<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MIDO LEGO® 復刻腕錶系列 | 精密機械與積木美學</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <style>
        /*
          ====================================================
          MIDO LEGO EDITION - 自訂樣式與設定
          ====================================================
        */
        :root {
            --color-gold: #C5A059;
            --color-bg: #0A0A0A;
            --section-spacing: 5rem; /* 修改這裡來調整區塊間距 */
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--color-bg);
            color: #E5E7EB;
        }

        .gold-text {
            background: linear-gradient(135deg, #F3E7C4 0%, #C5A059 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .watch-card {
            background: #141414;
            border: 1px solid rgba(197, 160, 89, 0.2);
            transition: all 0.3s ease;
        }
        .watch-card:hover {
            border-color: rgba(197, 160, 89, 0.8);
            transform: translateY(-5px);
        }
    </style>
</head>
<body class="bg-[#0A0A0A] text-gray-200">

    <!-- 導覽列 -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#0A0A0A]/90 backdrop-blur-md border-b border-white/10">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <a href="#" class="font-serif font-bold text-xl text-white tracking-widest">
                MIDO <span class="text-[#C5A059]">LEGO</span>
            </a>
            <nav class="hidden md:flex space-x-8 text-sm uppercase tracking-wider text-gray-300">
                <a href="#hero" class="hover:text-[#C5A059]">首頁</a>
                <a href="#collection" class="hover:text-[#C5A059]">精選錶款</a>
                <a href="#craftsmanship" class="hover:text-[#C5A059]">極致工藝</a>
            </nav>
        </div>
    </header>

    <!-- 首頁主視覺 -->
    <section id="hero" class="min-h-screen flex items-center justify-center px-6 pt-20">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6 text-center md:text-left">
                <span class="text-xs uppercase tracking-[0.3em] text-[#C5A059] font-semibold">2026 限量尊榮發表</span>
                <h1 class="font-serif text-4xl md:text-6xl font-bold leading-tight">
                    建築靈感與 <br><span class="gold-text">積木美學</span>的交融
                </h1>
                <p class="text-gray-400 font-light text-sm md:text-base leading-relaxed">
                    將經典瑞士美度表工藝與積木結構完美結合，為收藏家打造跨界當代藝術傑作。
                </p>
                <a href="#collection" class="inline-block px-8 py-4 bg-[#C5A059] text-black text-xs font-bold uppercase tracking-widest rounded hover:bg-[#E2C382] transition-all">
                    探索系列
                </a>
            </div>
            <div class="flex justify-center">
                <div class="w-72 h-96 rounded-2xl bg-[#141414] border border-[#C5A059]/40 p-6 flex flex-col items-center justify-between shadow-2xl">
                    <div class="w-10 h-3 bg-[#C5A059] rounded-t"></div>
                    <div class="w-48 h-48 rounded-full border-2 border-[#C5A059]/40 flex items-center justify-center bg-black">
                        <span class="font-serif font-bold gold-text text-xl">MIDO LEGO</span>
                    </div>
                    <div class="text-xs text-[#C5A059] tracking-widest uppercase font-mono">AUTOMATIC</div>
                </div>
            </div>
        </div>
    </section>

    <!-- 精選錶款 -->
    <section id="collection" class="py-24 px-6 bg-[#0E0E0E]">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16 space-y-3">
                <h2 class="font-serif text-3xl md:text-4xl font-bold">精選 Lego 復刻錶款</h2>
                <div class="w-12 h-0.5 bg-[#C5A059] mx-auto"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- 卡片 1 -->
                <div class="watch-card rounded-xl p-6 space-y-4">
                    <div class="h-48 bg-black/40 rounded-lg flex items-center justify-center border border-white/5">
                        <span class="font-serif text-[#C5A059] font-bold text-lg">Commander Lego</span>
                    </div>
                    <h3 class="font-serif text-xl font-bold text-white">尊爵黑金版</h3>
                    <p class="text-gray-400 text-xs leading-relaxed">經典指揮官外型，結合微型立體積木顆粒錶圈與細膩面盤。</p>
                    <div class="flex justify-between items-center pt-4 border-t border-white/10">
                        <span class="text-[#C5A059] font-bold font-serif">NT$ 38,800</span>
                        <button onclick="alert('已加入收藏清單！')" class="px-4 py-2 bg-[#C5A059] text-black text-xs font-bold rounded uppercase">鑑賞</button>
                    </div>
                </div>
                <!-- 卡片 2 -->
                <div class="watch-card rounded-xl p-6 space-y-4">
                    <div class="h-48 bg-black/40 rounded-lg flex items-center justify-center border border-white/5">
                        <span class="font-serif text-[#C5A059] font-bold text-lg">Ocean Star Lego</span>
                    </div>
                    <h3 class="font-serif text-xl font-bold text-white">潛水積木限定版</h3>
                    <p class="text-gray-400 text-xs leading-relaxed">兼具強悍防水與積木刻度設計，展現潮流冒險品味。</p>
                    <div class="flex justify-between items-center pt-4 border-t border-white/10">
                        <span class="text-[#C5A059] font-bold font-serif">NT$ 42,500</span>
                        <button onclick="alert('已加入收藏清單！')" class="px-4 py-2 bg-[#C5A059] text-black text-xs font-bold rounded uppercase">鑑賞</button>
                    </div>
                </div>
                <!-- 卡片 3 -->
                <div class="watch-card rounded-xl p-6 space-y-4">
                    <div class="h-48 bg-black/40 rounded-lg flex items-center justify-center border border-white/5">
                        <span class="font-serif text-[#C5A059] font-bold text-lg">Baroncelli Lego</span>
                    </div>
                    <h3 class="font-serif text-xl font-bold text-white">永恆美學版</h3>
                    <p class="text-gray-400 text-xs leading-relaxed">流暢圓形錶殼與積木紋理對比，完美詮釋經典優雅。</p>
                    <div class="flex justify-between items-center pt-4 border-t border-white/10">
                        <span class="text-[#C5A059] font-bold font-serif">NT$ 35,900</span>
                        <button onclick="alert('已加入收藏清單！')" class="px-4 py-2 bg-[#C5A059] text-black text-xs font-bold rounded uppercase">鑑賞</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 頁尾 -->
    <footer class="bg-black border-t border-white/10 py-12 px-6 text-center text-xs text-gray-500">
        <p>&copy; 2026 MIDO SWISS WATCHES & LEGO EDITION. All Rights Reserved.</p>
    </footer>

</body>
</html>